# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime user data (local-first; never committed)
user_data/
*.db
*.db-shm
*.db-wal

# Packaging
build/
dist/
*.spec

# Dev preview artifacts
tools/_preview/

# Fonts: commit only the freely-redistributable runtime fonts placed directly
# in assets/fonts/ (Atkinson Hyperlegible original — free for all use). Bulk
# download packages and personal-use-only desktop fonts stay local, uncommitted.
assets/fonts/**
!assets/fonts/README.md
!assets/fonts/*.ttf
!assets/fonts/*.otf

# OS / editor
.DS_Store
Thumbs.db
